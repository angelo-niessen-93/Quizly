# Required: generate a private signing key (see README Quick Start).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local HTTP development only; use true for HTTPS deployment.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=false
CSRF_TRUSTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Original frontend has no CSRF header. Exact trusted loopback origins only;
# effective only with DEBUG=true, HTTP loopback API, and non-secure cookies.
# Production: false; production clients must send a CSRF token.
LOCAL_FRONTEND_CSRF_COMPATIBILITY=true
# Required only for quiz generation; obtain your own key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Server deadline; the HTTP client receives an additional 10-second margin.
GEMINI_TIMEOUT_SECONDS=180
# Includes thinking tokens; truncated quiz content is rejected.
GEMINI_MAX_OUTPUT_TOKENS=8192
WHISPER_MODEL=small
# auto uses CUDA when available and otherwise CPU; cpu needs no NVIDIA GPU.
WHISPER_DEVICE=auto
# Optional model cache; defaults to .cache/whisper in the backend directory.
# WHISPER_CACHE_DIR=
# Optional directory containing ffmpeg and ffprobe, otherwise use PATH.
FFMPEG_LOCATION=
